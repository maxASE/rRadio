# --- Required -----------------------------------------------------------------
# Passwords for Icecast (the streaming server). Use anything long and random.
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin

# Your Invidious instance, as seen from inside the controller container.
#  - Invidious on the same host, port published:  http://host.docker.internal:3000
#  - Invidious on another machine:                 http://192.168.1.20:3000
#  - Invidious container on a shared Docker network: http://invidious:3000
INVIDIOUS_URL=http://host.docker.internal:3000

# --- Optional -----------------------------------------------------------------
# Navidrome (or another Subsonic server) for stations that play your own music.
# The URL and user can also be set in the web UI; keeping the password here
# keeps it out of config.yaml.
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

TZ=Europe/Berlin
STATION_NAME=rRadio

# First station added on the very first start (more can be added in the web UI).
DEFAULT_STATION_URL=

# Protect the web UI with a password (user is "admin" unless UI_USERNAME is set).
UI_PASSWORD=
UI_USERNAME=admin
# Let dashboards (e.g. Homepage) read /api/widget without the password.
# It only shows what is on air, so it is safe on a home network.
WIDGET_PUBLIC=false

# Ports on the host.
UI_PORT=8080
ICECAST_PORT=8000

# Hostname Icecast reports in its own status pages.
ICECAST_HOSTNAME=localhost

# Where listeners reach the streams, used for the links and .m3u/.pls files.
# Leave empty to use http://<host you opened the UI with>:ICECAST_PORT.
# Behind nginx, e.g.: https://radio.home.lan
PUBLIC_STREAM_BASE=

# Icecast mounts: one per channel and stream format (5 formats: 10 channels need 50).
ICECAST_MAX_SOURCES=100

# Size of the RAM disk for downloaded clips (used when "Keep downloads in RAM"
# is on in Settings). One clip needs roughly 0.5-1 MB per minute of audio.
RAM_CACHE_SIZE=512m

# Fade between radio and cut-ins, and volume change for cut-ins (dB).
FADE_SECONDS=1.5
CUTIN_GAIN_DB=0
